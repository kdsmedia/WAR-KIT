<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WarKit" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/warkit_bg</item>
        <item name="colorPrimary">@color/warkit_primary</item>
        <item name="colorPrimaryDark">@color/warkit_primary_dark</item>
        <item name="colorAccent">@color/warkit_accent</item>
        <item name="colorButtonNormal">@color/warkit_primary</item>
        <item name="android:buttonStyle">@style/Widget.WarKit.Button</item>
        <item name="android:fontFamily">@font/baloo_2_family</item>
        <item name="fontFamily">@font/baloo_2_family</item>
    </style>

    <style name="Theme.WarKit.Fullscreen" parent="Theme.WarKit">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/warkit_panel_dark</item>
    </style>

    <!-- Tombol modern: rounded, teks putih bold, font Fredoka Bold -->
    <style name="Widget.WarKit.Button" parent="Widget.AppCompat.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/fredoka_family</item>
        <item name="fontFamily">@font/fredoka_family</item>
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>

